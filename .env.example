# ---- Database (Neon) ----
# Copy this file to .env.local and fill in real values.
# Get this from your Neon project dashboard -> Connection Details -> "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- AI provider ----
# Which provider the agent uses. One of: anthropic | openai-compatible
AI_PROVIDER="anthropic"

# Anthropic (default provider)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"

# OpenAI-compatible provider (also works for local LLMs: Ollama, LM Studio, vLLM, etc.)
# For Ollama:  OPENAI_BASE_URL="http://localhost:11434/v1", OPENAI_API_KEY="ollama"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
