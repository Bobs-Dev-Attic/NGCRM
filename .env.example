# ---- Database (Neon) ----
# Copy this file to .env.local and fill in real values.
# Get this from your Neon project dashboard -> Connection Details -> "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- Auth ----
# Secret used to sign session cookies. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ---- Email (optional) ----
# Set both to enable LIVE campaign sends via Resend (https://resend.com).
# Without these, campaign sends run as a dry run (no email is sent).
RESEND_API_KEY=""
RESEND_FROM="Your Org <hello@yourdomain.org>"

# ---- AI provider ----
# Which provider the agent uses. One of: anthropic | openai-compatible
AI_PROVIDER="anthropic"

# Anthropic (default provider)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"
# Only needed if ANTHROPIC_API_KEY is an ORGANIZATION-level key (not scoped to a
# workspace). Find it in the Anthropic Console under the workspace's settings.
# Leave blank when using a workspace-scoped key.
ANTHROPIC_WORKSPACE_ID=""

# OpenAI-compatible provider (also works for local LLMs: Ollama, LM Studio, vLLM, etc.)
# For Ollama:  OPENAI_BASE_URL="http://localhost:11434/v1", OPENAI_API_KEY="ollama"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
